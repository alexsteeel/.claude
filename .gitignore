# Ignore everything
*

# Python build artifacts (always ignore, even in allowed dirs)
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
*.eggs/

# But not these directories
!commands/
!commands/**
!skills/
!skills/**
!agents/
!agents/**
!hooks/
!hooks/**

# And not .gitignore itself
!.gitignore

# And not .claude settings
!.claude/
!.claude/**

# And not CLAUDE.md and README.md
!CLAUDE.md
!README.md

# And not settings example
!settings.example.json

# And not .env.example (but .env is ignored)
!.env.example

# And not cli
!cli/
!cli/**

# Ignore these in allowed directories (must be after ! rules)
**/__pycache__/
.claude/settings.local.json
